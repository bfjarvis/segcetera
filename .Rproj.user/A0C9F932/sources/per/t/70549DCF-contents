library(shiny)
library(plotly)
library(dplyr)

simplex_grid <- function(m, names = c("A", "B", "C", "D")) {
  grid <- expand.grid(
    x1 = 0:m,
    x2 = 0:m,
    x3 = 0:m
  )
  
  grid$x4 <- m - grid$x1 - grid$x2 - grid$x3
  grid <- subset(grid, x4 >= 0)
  grid <- grid / m
  
  names(grid) <- names
  grid
}

V <- rbind(
  A = c(0, 0, 0),
  B = c(1, 0, 0),
  C = c(0.5, sqrt(3)/2, 0),
  D = c(0.5, sqrt(3)/6, sqrt(2/3))
)

ui <- fluidPage(
  titlePanel("Interactive quaternary preference plot"),
  
  sidebarLayout(
    sidebarPanel(
      sliderInput("m", "Grid resolution", min = 4, max = 40, value = 15, step = 1),
      sliderInput("wA", "Weight A", min = -1, max = 1, value = 0.4, step = 0.05),
      sliderInput("wB", "Weight B", min = -1, max = 1, value = 0.2, step = 0.05),
      sliderInput("wC", "Weight C", min = -1, max = 1, value = -0.1, step = 0.05),
      sliderInput("wD", "Weight D", min = -1, max = 1, value = 0.3, step = 0.05)
    ),
    
    mainPanel(
      plotlyOutput("tetraPlot", height = "1000px")
    )
  )
)

server <- function(input, output, session) {
  
  output$tetraPlot <- renderPlotly({
    
    df <- simplex_grid(input$m)
    
    df$preference <- with(
      df,
      input$wA * A +
        input$wB * B +
        input$wC * C +
        input$wD * D
    )
    
    coords <- as.matrix(df[, c("A", "B", "C", "D")]) %*% V
    
    df$x <- coords[,1]
    df$y <- coords[,2]
    df$z <- coords[,3]
    
    edges <- rbind(
      c("A","B"), c("A","C"), c("A","D"),
      c("B","C"), c("B","D"), c("C","D")
    )
    
    p <- plot_ly()
    
    for(i in seq_len(nrow(edges))) {
      e <- edges[i,]
      p <- p %>%
        add_trace(
          x = V[e,1], y = V[e,2], z = V[e,3],
          type = "scatter3d",
          mode = "lines",
          line = list(width = 5, color = "black"),
          showlegend = FALSE,
          hoverinfo = "none"
        )
    }
    
    p %>%
      add_markers(
        data = df,
        x = ~x, y = ~y, z = ~z,
        marker = list(
          size = 5,
          color = ~preference,
          colorscale = "Viridis",
          showscale = TRUE,
          colorbar = list(title = "Preference"),
          opacity = 0.75
        ),
        text = ~paste0(
          "A: ", round(A, 2),
          "<br>B: ", round(B, 2),
          "<br>C: ", round(C, 2),
          "<br>D: ", round(D, 2),
          "<br>Preference: ", round(preference, 2)
        ),
        hoverinfo = "text"
      ) %>%
      add_text(
        x = V[,1],
        y = V[,2],
        z = V[,3],
        text = paste0("<b>", rownames(V), "</b>"),
        textfont = list(size = 24, color = "black"),
        showlegend = FALSE,
        hoverinfo = "none"
      ) %>%
      layout(
        scene = list(
          xaxis = list(visible = FALSE),
          yaxis = list(visible = FALSE),
          zaxis = list(visible = FALSE),
          aspectmode = "data"
        )
      )
  })
}

shinyApp(ui, server)